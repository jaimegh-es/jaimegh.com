---
import { ArrowUpRight } from "lucide-astro";

interface Props {
	demoUrl?: string;
	githubUrl?: string;
	demoLabel: string;
	codeLabel: string;
}

const { demoUrl, githubUrl, demoLabel, codeLabel } = Astro.props;
---

{demoUrl && (
	<a href={demoUrl} target="_blank" rel="noopener noreferrer">
		{demoLabel} <ArrowUpRight size={13} />
	</a>
)}
{githubUrl && (
	<a href={githubUrl} target="_blank" rel="noopener noreferrer">
		{codeLabel} <ArrowUpRight size={13} />
	</a>
)}