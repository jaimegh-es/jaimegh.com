---
import { Mail, Github, Linkedin, Youtube, ArrowUpRight, MessageCircle, Send } from "lucide-astro";
import featuredData from "../data/featuredProjects.json";
import { getBlogPosts, createSlug } from "../lib/rss";

interface Props {
	lang: "es" | "en";
}

const { lang } = Astro.props;

const t = {
	es: {
		otherLang: "EN",
		otherLangUrl: "/en",
		role: "Desarrollador, usuario, friki y fundador",
		tagline:
			"Hola, soy JaimeGH, desarrollador fullstack y linux. Friki del sector :)",
		socials: "Redes sociales",
		contact: "Contacto",
		about: "Sobre mí",
		quote:
			"Realmente apasionado por el desarrollo, buscando siempre la manera de satisfacer las necesidades del usuario e innovar en cualquier campo relacionado con el desarrollo. Creador de la famosa extensión de GNOME 'Codexbar for GNOME', el navegador Seafari y el conjunto de distribuciones Pulsar OS (featured on Distrowatch). Haciendo comunidad sin elitismos en la que todos son bienvenidos. Intentando salir de la Matrix y la telepantalla. Buscando aprender y mejorar continuamente.",
		featured: "Proyectos destacados",
		blog: "Blog",
		blogSub: "Artículos sobre desarrollo, tecnología y más",
		inledSub: "Mi marca bajo la cual desarrollo la gran mayoría de proyectos.",
		demo: "Demo",
		code: "Código",
	},
	en: {
		otherLang: "ES",
		otherLangUrl: "/",
		role: "Developer, user, geek and founder",
		tagline:
			"Hello, I'm JaimeGH, fullstack and linux developer. Industry geek :)",
		socials: "Social links",
		contact: "Contact",
		about: "About me",
		quote:
			"Really passionate about development, always looking for ways to satisfy user needs and innovate in any field related to development. Creator of the famous GNOME extension 'Codexbar for GNOME', the Seafari browser and the Pulsar OS distribution suite (featured on Distrowatch). Creating a community without elitism in which everyone is welcome. Trying to get out of the Matrix and the telescreen. Looking to continually learn and improve.",
		featured: "Featured projects",
		blog: "Blog",
		blogSub: "Articles about development, technology and more",
		inledSub: "My brand under which I develop the vast majority of projects.",
		demo: "Demo",
		code: "Code",
	},
}[lang];

const avatar = "https://avatars.githubusercontent.com/u/200265524?v=4";
const year = new Date().getFullYear();

interface FeaturedProject {
	title: string;
	description: string;
	descriptionEn?: string;
	image: string;
	technologies: string[];
	demoUrl?: string;
	githubUrl?: string;
	type: string;
}

interface ProjectAction {
	href: string;
	label: string;
}

const featuredProjects = (featuredData as FeaturedProject[]).map((p) => ({
	...p,
	actions: [
		p.demoUrl ? { href: p.demoUrl, label: t.demo } : null,
		p.githubUrl ? { href: p.githubUrl, label: t.code } : null,
	].filter((a): a is ProjectAction => a !== null),
}));

const posts = (await getBlogPosts()).slice(0, 4);

const dateLocale = lang === "es" ? "es-ES" : "en-US";

function formatDate(date: string) {
	return new Date(date).toLocaleDateString(dateLocale, {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

const socials = [
	{
		label: "GitHub",
		value: "@jaimegh-es",
		href: "https://github.com/jaimegh-es",
		Icon: Github,
	},
	{
		label: "LinkedIn",
		value: "Jaime González Herráiz",
		href: "https://es.linkedin.com/in/jaimegonzalezherraiz",
		Icon: Linkedin,
	},
	{
		label: "YouTube",
		value: "@jaimegh-es",
		href: "https://www.youtube.com/@jaimegh-es",
		Icon: Youtube,
	},
];

const contact = [
	{
		label: "Telegram",
		value: "link.inled.es/telegram",
		href: "https://link.inled.es/telegram",
		Icon: Send,
	},
	{
		label: "Discord",
		value: "link.inled.es/discord",
		href: "https://link.inled.es/discord",
		Icon: MessageCircle,
	},
	{
		label: "Email",
		value: "contacto@inled.es",
		href: "mailto:contacto@inled.es",
		Icon: Mail,
	},
];

function desc(p: { description: string; descriptionEn?: string }) {
	return lang === "en" ? (p.descriptionEn ?? p.description) : p.description;
}
---

<main class="page">
	<div class="frame">
		<!-- HERO: foto + nombre + descripción -->
		<section class="hero">
			<div class="cell hero-photo">
				<img src={avatar} alt="Foto de Jaime González Herráiz" />
			</div>
			<div class="cell hero-info">
				<div class="hero-top">
					<span class="mono-label">{t.role}</span>
					<a class="lang" href={t.otherLangUrl}>{t.otherLang}</a>
				</div>
				<h1 class="name">Jaime González Herráiz</h1>
				<p class="tagline">{t.tagline}</p>
			</div>
		</section>

		<!-- REDES SOCIALES -->
		<div class="section-label"><span class="num">01</span> {t.socials}</div>
		<section class="row-3">
			{socials.map(({ label, value, href, Icon }) => (
				<a class="cell link-cell" href={href} target="_blank" rel="noopener noreferrer">
					<div class="cell-head">
						<Icon size={16} strokeWidth={1.5} />
						<ArrowUpRight class="arrow" size={14} strokeWidth={1.5} />
					</div>
					<span class="cell-name">{label}</span>
					<span class="cell-handle">{value}</span>
				</a>
			))}
		</section>

		<!-- CONTACTO -->
		<div class="section-label"><span class="num">02</span> {t.contact}</div>
		<section class="row-3">
			{contact.map(({ label, value, href, Icon }) => (
				<a class="cell link-cell" href={href} target="_blank" rel="noopener noreferrer">
					<div class="cell-head">
						<Icon size={16} strokeWidth={1.5} />
						<ArrowUpRight class="arrow" size={14} strokeWidth={1.5} />
					</div>
					<span class="cell-name">{label}</span>
					<span class="cell-handle">{value}</span>
				</a>
			))}
		</section>

		<!-- SOBRE MÍ -->
		<div class="section-label"><span class="num">03</span> {t.about}</div>
		<section class="row-1">
			<div class="cell quote">{t.quote}</div>
		</section>

		<!-- PROYECTOS DESTACADOS -->
		<div class="section-label"><span class="num">04</span> {t.featured}</div>
		{featuredProjects.map((p) => (
			<article class="project">
				<div class="cell project-thumb">
					<img src={p.image} alt={p.title} loading="lazy" />
				</div>
				<div class="cell project-body">
					<h3 class="project-title">{p.title}</h3>
					<p class="project-desc">{desc(p)}</p>
				</div>
				{p.actions.length > 0 && (
					<div
						class="project-actions"
						style={`--cols: ${p.actions.length}`}
					>
						{p.actions.map((a) => (
							<a
								class="project-action"
								href={a.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								{a.label}
								<ArrowUpRight size={14} strokeWidth={1.5} />
							</a>
						))}
					</div>
				)}
			</article>
		))}

		<!-- BLOG -->
		<div class="section-label"><span class="num">05</span> {t.blog}</div>
		<div class="cell section-sub">{t.blogSub}</div>
		{posts.map((post) => (
			<a class="blog-row" href={`/blog/${createSlug(post.title)}`}>
				<span class="blog-date">{formatDate(post.pubDate)}</span>
				<span class="blog-title">{post.title}</span>
				<ArrowUpRight class="arrow" size={14} strokeWidth={1.5} />
			</a>
		))}

		<!-- INLED -->
		<a class="cta" href="https://inled.es" target="_blank" rel="noopener noreferrer">
			<span class="cta-domain">inled.es</span>
			<span class="cta-sub">
				{t.inledSub}
				<ArrowUpRight size={16} strokeWidth={1.5} />
			</span>
		</a>

		<!-- FOOTER -->
		<footer class="footer">
			<span>This website is free and open source, licensed under <a href="https://license.inled.es">MIT-INLED license</a>. </span>
			<a class="footer-blog" href="/blog">
				{t.blog}
				<ArrowUpRight size={13} strokeWidth={1.5} />
			</a>
		</footer>
	</div>
</main>

<script>
	// En pantallas táctiles (sin hover) el primer toque divide el recuadro
	// en sus celdas de acción; el segundo toque sobre una celda navega.
	if (window.matchMedia("(hover: none)").matches) {
		const cards = document.querySelectorAll<HTMLElement>(".project");
		cards.forEach((card) => {
			if (!card.querySelector(".project-actions")) return;
			card.addEventListener("click", (e) => {
				const target = e.target as HTMLElement;
				if (card.classList.contains("open") && target.closest("a")) return;
				e.preventDefault();
				const wasOpen = card.classList.contains("open");
				cards.forEach((c) => c.classList.remove("open"));
				if (!wasOpen) card.classList.add("open");
			});
		});
	}
</script>

<style>
	/* ---- Hero ---- */
	.hero {
		grid-template-columns: 180px 1fr;
	}

	.hero-photo {
		display: flex;
	}

	.hero-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-info {
		padding: 1.4rem 1.4rem 1.6rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.lang {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--line);
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.lang:hover {
		border-color: var(--line-strong);
		background: var(--hover);
	}

	.name {
		font-size: clamp(1.6rem, 5vw, 2.1rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin-bottom: 0.6rem;
	}

	.tagline {
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.55;
	}

	/* ---- Celdas enlazables (redes / contacto) ---- */
	.link-cell {
		padding: 1.1rem 1.1rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		transition: background 0.15s ease;
	}

	.link-cell:hover {
		background: var(--hover);
	}

	.cell-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--fg);
		margin-bottom: 0.7rem;
	}

	.cell-head .arrow,
	.blog-row .arrow {
		color: var(--muted);
		transition: transform 0.15s ease, color 0.15s ease;
	}

	.link-cell:hover .arrow,
	.blog-row:hover .arrow {
		color: var(--fg);
		transform: translate(2px, -2px);
	}

	.cell-name {
		font-size: 0.95rem;
		font-weight: 500;
	}

	.cell-handle {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	/* ---- Quote ---- */
	.quote {
		padding: 2rem 1.6rem;
		font-size: clamp(1.1rem, 2.6vw, 1.35rem);
		line-height: 1.6;
		font-weight: 400;
		color: var(--fg);
	}

	/* ---- Proyectos destacados ---- */
	.project {
		position: relative;
		grid-template-columns: 110px 1fr;
	}

	.project-thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.2rem;
	}

	.project-thumb img {
		width: 100%;
		height: 100%;
		max-height: 64px;
		object-fit: contain;
	}

	.project-body {
		padding: 1.2rem 1.4rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
	}

	.project-title {
		font-size: 1.05rem;
		font-weight: 500;
	}

	.project-desc {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.55;
		white-space: pre-line;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/*
		Acciones: al hover (o al tocar en mobile) el recuadro entero del
		proyecto se divide en 1 o 2 celdas clicables, una por acción.
	*/
	.project-actions {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(var(--cols, 2), 1fr);
		gap: 1px;
		background: var(--line);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	.project:hover .project-actions,
	.project.open .project-actions {
		opacity: 1;
		pointer-events: auto;
	}

	.project-action {
		background: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.project-action:hover {
		background: var(--fg);
		color: var(--bg);
	}

	/* ---- Blog (filas enlazables) ---- */
	.section-sub {
		padding: 0.7rem 1.1rem;
		color: var(--muted);
		font-size: 0.88rem;
		border-top: 1px solid var(--line);
	}

	.blog-row {
		display: grid;
		grid-template-columns: 8rem 1fr auto;
		align-items: baseline;
		gap: 1rem;
		padding: 1rem 1.1rem;
		border-top: 1px solid var(--line);
		transition: background 0.15s ease;
	}

	.blog-row:hover {
		background: var(--hover);
	}

	.blog-date {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		white-space: nowrap;
	}

	.blog-title {
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.4;
	}

	/* ---- CTA inled.es ---- */
	.cta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.8rem 1.6rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.cta:hover {
		background: var(--fg);
		color: var(--bg);
	}

	.cta-domain {
		font-size: clamp(1.6rem, 5vw, 2.1rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.cta-sub {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: color 0.15s ease;
	}

	.cta:hover .cta-sub {
		color: var(--bg);
	}

	/* ---- Footer ---- */
	.footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	.footer-blog {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		transition: color 0.15s ease;
	}

	.footer-blog:hover {
		color: var(--fg);
	}

	/* ---- Mobile: todo apilado en una columna ---- */
	@media (max-width: 640px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-photo {
			height: 200px;
		}

		.project {
			grid-template-columns: 1fr;
		}

		.project-thumb {
			padding: 1rem;
		}

		.project-thumb img {
			max-height: 48px;
		}

		.blog-row {
			grid-template-columns: 1fr auto;
			gap: 0.35rem 1rem;
		}

		.blog-date {
			grid-column: 1 / -1;
		}

		.footer {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}
</style>
