const sortedTechnologies = [...technologies].sort((a, b) => a.name.localeCompare(b.name));
---

<section class="technologies-section" id="technologies">
	<div class="section-container">
		<h2 class="section-title">Tecnologías</h2>

		<div class="technologies-grid">
			{
				sortedTechnologies.map((tech) => {
					const isSvg = tech.icon.trim().startsWith("<svg");
					const isSimpleIcon = tech.icon.includes("simpleicons.org");
					return (
						<div class="tech-card">
							<div class="tech-card-inner">
								<div
									class={`tech-icon ${isSimpleIcon ? "is-simpleicon" : ""}`}
								>
									{isSvg ? (
										<div
											class="svg-wrapper"
											set:html={tech.icon}
										/>
									) : (
										<img
											src={tech.icon}
											alt={`${tech.name} icon`}
											loading="lazy"
										/>
									)}
								</div>
								<h3 class="tech-name">{tech.name}</h3>
							</div>
							<div class="tech-glow" />
						</div>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.technologies-section {
		position: relative;
		z-index: 40;
		padding: 8rem 2rem;
		background: linear-gradient(
			180deg,
			rgba(10, 10, 10, 0.8) 0%,
			rgba(0, 0, 0, 0.5) 100%
		);
	}

	.section-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.section-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 300;
		text-align: center;
		margin-bottom: 3rem;
		background: linear-gradient(135deg, #fff, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		position: relative;
	}

	.section-title::after {
		content: "";
		position: absolute;
		bottom: -1rem;
		left: 50%;
		transform: translateX(-50%);
		width: 100px;
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.5),
			transparent
		);
	}

	.technologies-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 1.5rem;
	}

	.tech-card {
		position: relative;
		background: rgba(20, 20, 20, 0.6);
		backdrop-filter: blur(10px);
		border-radius: 16px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 2rem 1rem;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
		cursor: pointer;
	}

	.tech-card.hidden {
		display: none;
	}

	.tech-card-inner {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.tech-card:hover {
		transform: translateY(-8px) scale(1.02);
		border-color: rgba(255, 255, 255, 0.3);
		box-shadow:
			0 0 30px rgba(255, 255, 255, 0.15),
			0 15px 50px rgba(0, 0, 0, 0.5);
	}

	.tech-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 150%;
		height: 150%;
		background: radial-gradient(
			circle,
			rgba(255, 255, 255, 0.1) 0%,
			transparent 70%
		);
		transform: translate(-50%, -50%);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.tech-card:hover .tech-glow {
		opacity: 1;
	}

	.tech-icon {
		width: 64px;
		height: 64px;
		margin-bottom: 1rem;
		filter: grayscale(1) brightness(1.3) contrast(1.2)
			drop-shadow(0 0 10px rgba(255, 255, 255, 0.1));
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tech-icon.is-simpleicon {
		filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.2));
	}

	.tech-icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.svg-wrapper {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.svg-wrapper :global(svg) {
		width: 100%;
		height: 100%;
	}

	.tech-card:hover .tech-icon {
		transform: scale(1.1) rotate(5deg);
		filter: grayscale(0) brightness(1.1) contrast(1.1)
			drop-shadow(0 0 20px rgba(255, 255, 255, 0.3));
	}

	.tech-card:hover .tech-icon.is-simpleicon {
		filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.4));
	}

	.tech-name {
		font-size: 1.1rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 0.5rem;
	}

	@media (max-width: 768px) {
		.technologies-section {
			padding: 4rem 1.5rem;
		}

		.technologies-grid {
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: 1rem;
		}

		.tech-card {
			padding: 1.5rem 0.75rem;
		}

		.tech-icon {
			width: 48px;
			height: 48px;
		}

		.tech-name {
			font-size: 1rem;
		}
	}
</style>
