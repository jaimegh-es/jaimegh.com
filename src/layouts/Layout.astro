---
interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	type?: string;
	lang?: "es" | "en";
}

const {
	title,
	description = "Hola, soy JaimeGH, desarrollador fullstack y linux. Friki del sector :)",
	image = "/og-image.png",
	canonicalURL = new URL(
		Astro.url.pathname,
		Astro.site || "https://jaimegh.com",
	).href,
	type = "website",
	lang = "es",
} = Astro.props;

const siteName = "Jaime González Herráiz | JaimeGH";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{fullTitle}</title>
		<meta name="title" content={fullTitle} />
		<meta name="description" content={description} />
		<meta name="author" content="Jaime González Herráiz" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		--bg: #0a0a0a;
		--fg: #ededed;
		--muted: #8a8a8a;
		--line: rgba(255, 255, 255, 0.22);
		--line-strong: rgba(255, 255, 255, 0.45);
		--hover: rgba(255, 255, 255, 0.05);
		--font-sans: "Inter Tight", system-ui, sans-serif;
		--font-mono: "JetBrains Mono", ui-monospace, monospace;
	}

	body {
		background-color: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		font-weight: 400;
		overflow-x: hidden;
		position: relative;
		min-height: 100vh;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* ---- Primitivas del grid (compartidas por home y blog) ---- */
	.page {
		max-width: 780px;
		margin: 0 auto;
		padding: 3.5rem 1rem 4rem;
	}

	.frame {
		display: flex;
		flex-direction: column;
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}

	.frame > * {
		background: var(--bg);
	}

	.cell {
		background: var(--bg);
	}

	.row-1,
	.row-3,
	.hero,
	.project {
		display: grid;
		gap: 1px;
		background: var(--line);
	}

	.row-3 {
		grid-template-columns: repeat(3, 1fr);
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		padding: 0.7rem 1.1rem;
		background: var(--bg);
		border-top: 1px solid var(--line);
	}

	.section-label .num {
		color: var(--fg);
		margin-right: 0.6rem;
	}

	.mono-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.page {
			padding: 1.5rem 0.75rem 3rem;
		}

		.row-3 {
			grid-template-columns: 1fr;
		}
	}
</style>
