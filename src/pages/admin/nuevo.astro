---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { Plus, Copy, Check, Edit2, Trash2, RefreshCw } from "lucide-astro";
import { getPersonalProjects } from "../../data/personalProjects";

const existingProjects = getPersonalProjects();
---

<Layout title="Admin Proyectos - JaimeGH" description="La mayor vaguedad del mundo: añadir mis proyectos sin tocar el typescript. Así queda más bonito.">
	<Header />
	<main class="admin-page">
		<div class="admin-header">
			<h1 class="page-title">Gestión de Proyectos</h1>
			<p class="page-subtitle">Hay que ser cutre y vago para hacer esto pero quería probarlo.</p>
		</div>

		<div class="admin-grid-layout">
			<!-- List of existing projects -->
			<aside class="existing-projects">
				<div class="section-header">
					<h2>Tus Proyectos</h2>
					<button id="new-project-btn" class="icon-btn" title="Nuevo proyecto">
						<Plus size={20} />
					</button>
				</div>
				<div class="projects-list" id="projects-list">
					{existingProjects.map((project, index) => (
						<div class="project-item" data-index={index}>
							<div class="item-info">
								<span class="item-title">{project.title}</span>
								<span class="item-type">{project.type}</span>
							</div>
							<div class="item-actions">
								<button class="edit-btn" data-project={JSON.stringify(project)} title="Editar">
									<Edit2 size={16} />
								</button>
								<button class="delete-btn" data-index={index} data-title={project.title} title="Eliminar">
									<Trash2 size={16} />
								</button>
							</div>
						</div>
					))}
				</div>
			</aside>

			<!-- Form Section -->
			<div class="form-section">
				<form id="project-form" class="project-form">
					<h2 id="form-title">Nuevo Proyecto</h2>
					<div class="form-grid">
						<div class="form-group">
							<label for="title">Título del Proyecto</label>
							<input type="text" id="title" name="title" placeholder="Ej: Mi Increíble App" required />
						</div>
						<div class="form-group">
							<label for="type">Tipo</label>
							<select id="type" name="type">
								<option value="Personal">Personal</option>
								<option value="SaaS">SaaS</option>
								<option value="App">App</option>
								<option value="Open Source">Open Source</option>
								<option value="Experimental">Experimental</option>
							</select>
						</div>
						<div class="form-group full-width">
							<label for="description">Descripción</label>
							<textarea id="description" name="description" placeholder="Cuéntame de qué trata..." required></textarea>
						</div>
						<div class="form-group">
							<label for="image">URL de la Imagen (Logo)</label>
							<input type="url" id="image" name="image" placeholder="https://..." required />
						</div>
						<div class="form-group">
							<label for="technologies">Tecnologías (separadas por comas)</label>
							<input type="text" id="technologies" name="technologies" placeholder="Astro, TS, CSS" required />
						</div>
						<div class="form-group">
							<label for="demoUrl">URL de la Demo (Opcional)</label>
							<input type="url" id="demoUrl" name="demoUrl" placeholder="https://..." />
						</div>
						<div class="form-group">
							<label for="githubUrl">URL de GitHub (Opcional)</label>
							<input type="url" id="githubUrl" name="githubUrl" placeholder="https://github.com/..." />
						</div>
					</div>

					<div class="form-actions">
						<button type="submit" class="submit-btn">
							<RefreshCw id="update-icon" class="hidden" size={20} />
							<Plus id="add-icon" size={20} />
							<span id="submit-text">Generar Código</span>
						</button>
					</div>
				</form>

				<div id="result-container" class="result-container hidden">
					<div class="result-header">
						<h3>¡Código Generado!</h3>
						<button id="copy-btn" class="copy-btn">
							<Copy id="copy-icon" size={20} />
							<Check id="check-icon" class="hidden" size={20} />
							Copiar Objeto
						</button>
					</div>
					<p class="instruction">Pégalo en <code>src/data/personalProjects.ts</code></p>
					<pre><code id="generated-code"></code></pre>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	const form = document.getElementById('project-form') as HTMLFormElement;
	const formTitle = document.getElementById('form-title');
	const submitText = document.getElementById('submit-text');
	const addIcon = document.getElementById('add-icon');
	const updateIcon = document.getElementById('update-icon');
	const resultContainer = document.getElementById('result-container');
	const codeElement = document.getElementById('generated-code');
	const copyBtn = document.getElementById('copy-btn');
	const copyIcon = document.getElementById('copy-icon');
	const checkIcon = document.getElementById('check-icon');
	const newProjectBtn = document.getElementById('new-project-btn');
	const projectsList = document.getElementById('projects-list');

	// Local state for projects (initialized from the server-rendered list)
	let projects = Array.from(document.querySelectorAll('.edit-btn')).map(btn => {
		return JSON.parse((btn as HTMLButtonElement).dataset.project || '{}');
	});

	// Handle Edit and Delete
	projectsList?.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		
		const editBtn = target.closest('.edit-btn') as HTMLButtonElement;
		if (editBtn) {
			const project = JSON.parse(editBtn.dataset.project || '{}');
			loadProject(project);
			return;
		}

		const deleteBtn = target.closest('.delete-btn') as HTMLButtonElement;
		if (deleteBtn) {
			const index = parseInt(deleteBtn.dataset.index || '0');
			const title = deleteBtn.dataset.title;
			if (confirm(`¿Estás seguro de que quieres eliminar "${title}"?`)) {
				deleteProject(index);
			}
		}
	});

	function deleteProject(index: number) {
		projects.splice(index, 1);
		const code = "export const personalProjects: Project[] = " + JSON.stringify(projects, null, 2) + ";";
		
		if (codeElement) codeElement.textContent = code;
		if (formTitle) formTitle.textContent = "Proyecto Eliminado";
		
		const instruction = document.querySelector('.instruction');
		if (instruction) instruction.innerHTML = "Has eliminado un proyecto. <strong>Sustituye todo el contenido</strong> de <code>src/data/personalProjects.ts</code> con este código:";
		
		resultContainer?.classList.remove('hidden');
		resultContainer?.scrollIntoView({ behavior: 'smooth' });
		
		// Update the list UI
		const items = document.querySelectorAll('.project-item');
		if (items[index]) {
			(items[index] as HTMLElement).style.display = 'none';
		}
	}

	newProjectBtn?.addEventListener('click', () => {
		form.reset();
		resetFormUI();
	});

	function loadProject(project: any) {
		const titleInput = document.getElementById('title') as HTMLInputElement;
		const typeInput = document.getElementById('type') as HTMLSelectElement;
		const descInput = document.getElementById('description') as HTMLTextAreaElement;
		const imgInput = document.getElementById('image') as HTMLInputElement;
		const techInput = document.getElementById('technologies') as HTMLInputElement;
		const demoInput = document.getElementById('demoUrl') as HTMLInputElement;
		const githubInput = document.getElementById('githubUrl') as HTMLInputElement;

		titleInput.value = project.title;
		typeInput.value = project.type;
		descInput.value = project.description;
		imgInput.value = project.image;
		techInput.value = project.technologies.join(', ');
		demoInput.value = project.demoUrl || '';
		githubInput.value = project.githubUrl || '';

		if (formTitle) formTitle.textContent = "Editando: " + project.title;
		if (submitText) submitText.textContent = "Actualizar Código";
		addIcon?.classList.add('hidden');
		updateIcon?.classList.remove('hidden');
		
		form.scrollIntoView({ behavior: 'smooth' });
	}

	function resetFormUI() {
		if (formTitle) formTitle.textContent = "Nuevo Proyecto";
		if (submitText) submitText.textContent = "Generar Código";
		addIcon?.classList.remove('hidden');
		updateIcon?.classList.add('hidden');
		resultContainer?.classList.add('hidden');
	}

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const formData = new FormData(form);
		
		const project = {
			title: formData.get('title'),
			description: formData.get('description'),
			image: formData.get('image'),
			technologies: (formData.get('technologies') as string).split(',').map(t => t.trim()),
			demoUrl: formData.get('demoUrl') || undefined,
			githubUrl: formData.get('githubUrl') || undefined,
			type: formData.get('type')
		};

		const code = JSON.stringify(project, null, 2) + ',';
		if (codeElement) codeElement.textContent = code;
		resultContainer?.classList.remove('hidden');
		resultContainer?.scrollIntoView({ behavior: 'smooth' });
	});

	copyBtn?.addEventListener('click', () => {
		const code = codeElement?.textContent || '';
		navigator.clipboard.writeText(code).then(() => {
			copyIcon?.classList.add('hidden');
			checkIcon?.classList.remove('hidden');
			setTimeout(() => {
				copyIcon?.classList.remove('hidden');
				checkIcon?.classList.add('hidden');
			}, 2000);
		});
	});
</script>

<style>
	.admin-page {
		min-height: 100vh;
		padding: 10rem 2rem 6rem;
		background: #050505;
	}

	.admin-header {
		max-width: 1200px;
		margin: 0 auto 4rem;
		text-align: center;
	}

	.page-title {
		font-size: 3rem;
		font-weight: 300;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #fff, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.page-subtitle {
		color: rgba(255, 255, 255, 0.5);
		font-size: 1.1rem;
	}

	.admin-grid-layout {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 350px 1fr;
		gap: 3rem;
		align-items: start;
	}

	.existing-projects {
		background: rgba(20, 20, 20, 0.6);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 24px;
		padding: 2rem;
		max-height: 80vh;
		overflow-y: auto;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.section-header h2 {
		font-size: 1.2rem;
		font-weight: 400;
		color: white;
	}

	.icon-btn {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: white;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.icon-btn:hover {
		background: white;
		color: black;
	}

	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project-item {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 16px;
		padding: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: all 0.3s ease;
	}

	.project-item:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.15);
	}

	.item-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.item-title {
		color: white;
		font-weight: 500;
	}

	.item-type {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.edit-btn {
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.5);
		cursor: pointer;
		transition: color 0.3s ease;
		padding: 0.5rem;
	}

	.edit-btn:hover {
		color: white;
	}

	.delete-btn {
		background: transparent;
		border: none;
		color: rgba(255, 70, 70, 0.5);
		cursor: pointer;
		transition: all 0.3s ease;
		padding: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.delete-btn:hover {
		color: #ff4646;
		transform: scale(1.1);
	}

	.project-form {
		background: rgba(20, 20, 20, 0.6);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 24px;
		padding: 3rem;
	}

	.project-form h2 {
		font-size: 2rem;
		font-weight: 300;
		margin-bottom: 2.5rem;
		color: white;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.full-width {
		grid-column: span 2;
	}

	label {
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.9rem;
		font-weight: 500;
	}

	input, select, textarea {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 1rem;
		color: white;
		font-size: 1rem;
		transition: all 0.3s ease;
	}

	input:focus, select:focus, textarea:focus {
		outline: none;
		border-color: rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.05);
	}

	textarea {
		min-height: 120px;
		resize: vertical;
	}

	.submit-btn {
		margin-top: 3rem;
		width: 100%;
		padding: 1.2rem;
		background: white;
		color: black;
		border: none;
		border-radius: 12px;
		font-size: 1.1rem;
		font-weight: 600;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.submit-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
	}

	.result-container {
		margin-top: 4rem;
		background: rgba(30, 30, 30, 0.4);
		border: 1px dashed rgba(255, 255, 255, 0.2);
		border-radius: 24px;
		padding: 2.5rem;
	}

	.hidden {
		display: none;
	}

	.result-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.result-header h3 {
		font-size: 1.5rem;
		font-weight: 400;
	}

	.copy-btn {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: white;
		padding: 0.6rem 1.2rem;
		border-radius: 8px;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.copy-btn:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.instruction {
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 1.5rem;
	}

	pre {
		background: #000;
		padding: 1.5rem;
		border-radius: 12px;
		overflow-x: auto;
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	code {
		color: #10b981;
		font-family: 'Fira Code', monospace;
		font-size: 0.9rem;
	}

	@media (max-width: 1024px) {
		.admin-grid-layout {
			grid-template-columns: 1fr;
		}
		.existing-projects {
			max-height: 300px;
		}
	}

	@media (max-width: 768px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
		.full-width {
			grid-column: span 1;
		}
		.project-form {
			padding: 1.5rem;
		}
	}
</style>
