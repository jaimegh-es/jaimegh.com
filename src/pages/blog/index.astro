---
import Layout from "../../layouts/Layout.astro";
import MobileIsland from "../../components/MobileIsland.astro";
import { getBlogPosts, createSlug } from "../../lib/rss";
import { ArrowUpRight, ArrowLeft } from "lucide-astro";

const posts = await getBlogPosts();

function formatDate(date: string) {
	return new Date(date).toLocaleDateString("es-ES", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
}
---

<Layout
	title="Blog - JaimeGH"
	description="Explora artículos sobre desarrollo web, inteligencia artificial, emprendimiento y tecnología en el blog de Jaime González Herráiz."
>
	<main class="page">
		<div class="frame">
			<!-- Barra superior -->
			<div class="topbar">
				<a class="back" href="/">
					<ArrowLeft size={14} strokeWidth={1.5} />
					JaimeGH
				</a>
				<span class="mono-label">Blog</span>
			</div>

			<!-- Cabecera -->
			<header class="cell blog-head">
				<h1>Blog</h1>
				<p>Artículos sobre desarrollo, tecnología y más</p>
			</header>

			<!-- Entradas -->
			{posts.map((post, i) => (
				<a class="entry" href={`/blog/${createSlug(post.title)}`}>
					<span class="entry-index">
						{String(i + 1).padStart(2, "0")}
					</span>
					<div class="entry-body">
						<div class="entry-meta">
							<time datetime={post.isoDate}>{formatDate(post.pubDate)}</time>
						</div>
						<h2 class="entry-title">{post.title}</h2>
						<p class="entry-excerpt">
							{post.contentSnippet.slice(0, 180)}...
						</p>
					</div>
					<ArrowUpRight class="arrow" size={16} strokeWidth={1.5} />
				</a>
			))}

			{posts.length === 0 && (
				<div class="cell empty">No hay entradas disponibles.</div>
			)}

			<!-- Footer -->
			<footer class="footer">
				<span>© {new Date().getFullYear()} Jaime González Herráiz</span>
				<a class="footer-blog" href="/">
					<ArrowLeft size={13} strokeWidth={1.5} />
					Volver
				</a>
			</footer>
		</div>
	</main>
	<MobileIsland />
</Layout>

<style>
	/* ---- Barra superior ---- */
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid var(--line);
	}

	.back {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition: color 0.15s ease;
	}

	.back:hover {
		color: var(--fg);
	}

	/* ---- Cabecera ---- */
	.blog-head {
		padding: 2.2rem 1.6rem;
	}

	.blog-head h1 {
		font-size: clamp(1.9rem, 6vw, 2.6rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
	}

	.blog-head p {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* ---- Entradas ---- */
	.entry {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: start;
		gap: 1.2rem;
		padding: 1.4rem 1.4rem;
		border-top: 1px solid var(--line);
		transition: background 0.15s ease;
	}

	.entry:hover {
		background: var(--hover);
	}

	.entry-index {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		padding-top: 0.3rem;
	}

	.entry-meta {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.entry-title {
		font-size: 1.15rem;
		font-weight: 500;
		line-height: 1.35;
		margin-bottom: 0.5rem;
	}

	.entry-excerpt {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.entry .arrow {
		color: var(--muted);
		align-self: center;
		transition: transform 0.15s ease, color 0.15s ease;
	}

	.entry:hover .arrow {
		color: var(--fg);
		transform: translate(2px, -2px);
	}

	.empty {
		padding: 2rem 1.4rem;
		color: var(--muted);
		border-top: 1px solid var(--line);
	}

	/* ---- Footer ---- */
	.footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 1.1rem;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	.footer-blog {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		transition: color 0.15s ease;
	}

	.footer-blog:hover {
		color: var(--fg);
	}

	/* ---- Mobile ---- */
	@media (max-width: 640px) {
		.entry {
			grid-template-columns: 1fr auto;
			gap: 0.5rem 1rem;
			padding: 1.2rem 1.1rem;
		}

		.entry-index {
			display: none;
		}

		.entry .arrow {
			align-self: start;
			padding-top: 0.25rem;
		}
	}
</style>
