---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { ExternalLink, Github } from "lucide-astro";
import { getAllProjects } from "../data/projects";
import { getPersonalProjects } from "../data/personalProjects";

const inledProjects = await getAllProjects();
const personalProjects = getPersonalProjects();
---

<Layout
	title="Proyectos - JaimeGH"
	description="Una selección de mis proyectos personales y colaboraciones con Inled. Desde aplicaciones SaaS hasta soluciones innovadoras."
>
	<Header />
	<main class="projects-page">
		<div class="projects-header">
			<h1 class="page-title">Proyectos</h1>
			<p class="page-subtitle">
				Explora mi trabajo personal y mis desarrollos para Inled
			</p>
		</div>

		<div class="projects-container">
			<!-- Personal Projects Section -->
			<section class="projects-section">
				<h2 class="category-title">Proyectos Personales</h2>
				<p class="category-subtitle">Desarrollos independientes y experimentos propios</p>
				<div class="projects-grid">
					{
						personalProjects.map((project) => (
							<article class="project-card">
								<div class="project-image-container">
									<div class="project-image-bg"></div>
									<img
										src={project.image}
										alt={project.title}
										class="project-image"
									/>
									<div class="project-type-badge">
										{project.type}
									</div>
									<div class="project-overlay">
										<div class="project-links">
											{project.demoUrl && (
												<a
													href={project.demoUrl}
													class="project-link"
													target="_blank"
													rel="noopener noreferrer"
													title="Ver demo"
												>
													<ExternalLink size={24} />
												</a>
											)}
											{project.githubUrl && (
												<a
													href={project.githubUrl}
													class="project-link"
													target="_blank"
													rel="noopener noreferrer"
													title="Ver código"
												>
													<Github size={24} />
												</a>
											)}
										</div>
									</div>
								</div>
								<div class="project-content">
									<h3 class="project-title">{project.title}</h3>
									<p class="project-description">
										{project.description}
									</p>
									<div class="project-technologies">
										{project.technologies.map((tech) => (
											<span class="tech-tag">{tech}</span>
										))}
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- Inled Projects Section -->
			<section class="projects-section">
				<h2 class="category-title">Proyectos de Inled</h2>
				<p class="category-subtitle">Soluciones y servicios desarrollados para mi marca</p>
				<div class="projects-grid">
					{
						inledProjects.map((project) => (
							<article class="project-card">
								<div class="project-image-container">
									<div class="project-image-bg"></div>
									<img
										src={project.image}
										alt={project.title}
										class="project-image"
									/>
									<div class="project-type-badge">
										{project.technologies[0]}
									</div>
									<div class="project-overlay">
										<div class="project-links">
											{project.demoUrl && (
												<a
													href={project.demoUrl}
													class="project-link"
													target="_blank"
													rel="noopener noreferrer"
													title="Ver demo"
												>
													<ExternalLink size={24} />
												</a>
											)}
											{project.githubUrl && (
												<a
													href={project.githubUrl}
													class="project-link"
													target="_blank"
													rel="noopener noreferrer"
													title="Ver código"
												>
													<Github size={24} />
												</a>
											)}
										</div>
									</div>
								</div>
								<div class="project-content">
									<h3 class="project-title">{project.title}</h3>
									<p class="project-description">
										{project.description}
									</p>
									<div class="project-technologies">
										{project.technologies.map((tech) => (
											<span class="tech-tag">{tech}</span>
										))}
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	.projects-page {
		position: relative;
		z-index: 40;
		min-height: 100vh;
		padding: 12rem 2rem 6rem;
	}

	.projects-header {
		max-width: 1400px;
		margin: 0 auto 6rem;
		text-align: center;
	}

	.category-title {
		font-size: 2.5rem;
		font-weight: 300;
		color: #fff;
		margin-bottom: 0.5rem;
		text-align: left;
	}

	.category-subtitle {
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 3rem;
		text-align: left;
	}

	.projects-section {
		margin-bottom: 8rem;
	}

	.page-title {
		font-size: clamp(3rem, 6vw, 5rem);
		font-weight: 300;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, #fff, #888);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		position: relative;
	}

	.page-title::after {
		content: "";
		position: absolute;
		bottom: -1rem;
		left: 50%;
		transform: translateX(-50%);
		width: 100px;
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.5),
			transparent
		);
	}

	.page-subtitle {
		font-size: 1.3rem;
		color: rgba(255, 255, 255, 0.6);
		margin-top: 2rem;
	}

	.projects-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
		gap: 2.5rem;
	}

	.project-card {
		background: rgba(20, 20, 20, 0.6);
		backdrop-filter: blur(10px);
		border-radius: 20px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		overflow: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project-card:hover {
		transform: translateY(-10px);
		border-color: rgba(255, 255, 255, 0.3);
		box-shadow:
			0 0 30px rgba(255, 255, 255, 0.1),
			0 20px 60px rgba(0, 0, 0, 0.5);
	}

	.project-image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.02);
	}

	.project-image-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at center, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
	}

	.project-image {
		width: 80%;
		height: 80%;
		object-fit: contain;
		transition: transform 0.4s ease;
		z-index: 1;
	}

	.project-type-badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.4rem 0.8rem;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(5px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 8px;
		font-size: 0.75rem;
		font-weight: 600;
		color: white;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		z-index: 2;
	}

	.project-card:hover .project-image {
		transform: scale(1.05);
	}

	.project-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
		z-index: 10;
	}

	.project-card:hover .project-overlay {
		opacity: 1;
	}

	.project-links {
		display: flex;
		gap: 1.5rem;
	}

	.project-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 50px;
		height: 50px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 50%;
		color: white;
		text-decoration: none;
		transition: all 0.3s ease;
		backdrop-filter: blur(10px);
	}

	.project-link:hover {
		background: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.5);
		transform: scale(1.1);
	}

	.project-content {
		padding: 2rem;
	}

	.project-title {
		font-size: 1.8rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.95);
		margin-bottom: 1rem;
	}

	.project-description {
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.project-technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tech-tag {
		padding: 0.4rem 1rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 20px;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
	}

	@media (max-width: 768px) {
		.projects-page {
			padding: 10rem 1.5rem 4rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.project-content {
			padding: 1.5rem;
		}

		.project-title {
			font-size: 1.5rem;
		}
	}
</style>
